#!/usr/bin/env bash
# OpenGantry tracked hook (ADR-0052 A8): the CLI does the work. See: gantry hook post-checkout --help
cd "$(git rev-parse --show-toplevel)" || exit 1
if [[ -f dist/cli/index.js ]]; then exec node dist/cli/index.js hook post-checkout "$@"; fi
if command -v gantry >/dev/null 2>&1; then exec gantry hook post-checkout "$@"; fi
echo "post-checkout: gantry not found — run: npm run build (this repo) or npm install -g @jeger-ai/opengantry" >&2
exit 1
