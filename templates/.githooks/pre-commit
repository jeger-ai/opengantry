#!/usr/bin/env bash
# OpenGantry tracked hook (ADR-0052 A8): the CLI does the work. See: gantry hook pre-commit --help
cd "$(git rev-parse --show-toplevel)" || exit 1
if [[ -f dist/cli/index.js ]]; then exec node dist/cli/index.js hook pre-commit "$@"; fi
if command -v gantry >/dev/null 2>&1; then exec gantry hook pre-commit "$@"; fi
echo "pre-commit: gantry not found — run: npm run build (this repo) or npm install -g @jeger-ai/opengantry" >&2
exit 1
