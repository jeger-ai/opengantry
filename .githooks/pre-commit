#!/usr/bin/env bash
# OpenGantry pre-commit: advisory TMVC path guard (staged index vs mission roots).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [[ -f dist/cli/index.js ]]; then
  GANTRY_CLI=(node dist/cli/index.js)
elif command -v gantry >/dev/null 2>&1; then
  GANTRY_CLI=(gantry)
else
  echo "pre-commit: gantry not found — run: npm run build" >&2
  exit 1
fi

mission=""
if mission="$(scripts/gxt-resolve-mission.sh 2>/dev/null)"; then
  :
else
  echo "pre-commit: no pinned mission — skipping TMVC guard (advisory)" >&2
  exit 0
fi

guard_args=(tmvc guard --mission "$mission")
strict_cfg="$(git config --get gxt.tmvcGuardStrict 2>/dev/null || true)"
if [[ "$strict_cfg" == "true" || "${GXT_TMVC_GUARD_STRICT:-}" == "1" ]]; then
  guard_args+=(--strict)
  echo "pre-commit: gantry tmvc guard --strict (commit blocked on TMVC drift; bypass: git commit --no-verify)" >&2
else
  echo "pre-commit: gantry tmvc guard --mission ${mission} (advisory default)" >&2
fi
"${GANTRY_CLI[@]}" "${guard_args[@]}"

# Advisory contract import scan over staged source files (mission contract cage, ADR-0045).
staged_sources=()
while IFS= read -r f; do
  case "$f" in
    *.ts|*.tsx|*.mts|*.cts|*.js|*.jsx|*.mjs|*.cjs) staged_sources+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
if [[ ${#staged_sources[@]} -gt 0 ]]; then
  echo "pre-commit: gantry contract check --mission ${mission} (advisory, ${#staged_sources[@]} staged source file(s))" >&2
  "${GANTRY_CLI[@]}" contract check --mission "$mission" --file "${staged_sources[@]}" >&2 || true
fi
exit 0
