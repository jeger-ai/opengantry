{
  "name": "@jeger-ai/opengantry",
  "version": "4.0.0",
  "description": "Open Source Gantry — vendor-neutral GXT substrate and Gantry CLI for local git-native agent governance",
  "type": "module",
  "bin": {
    "gantry": "dist/cli/index.js",
    "gantry-cage": "dist/cli/cage-bin.js",
    "opengantry-cage": "dist/cli/cage-bin.js",
    "gantry-verify": "dist/cli/verify-bin.js"
  },
  "imports": {
    "#core/*": "./dist/packages/core/src/*",
    "#git/*": "./dist/packages/git/src/*",
    "#cage/*": "./dist/packages/cage/src/*",
    "#plane/*": "./dist/packages/plane/src/*",
    "#verify/*": "./dist/packages/verify/src/*",
    "#missions/*": "./dist/packages/missions/src/*"
  },
  "exports": {
    ".": "./dist/cli/index.js",
    "./kernel": "./dist/cli/kernel.js"
  },
  "files": [
    "dist",
    "!dist/cli/tests",
    "!dist/packages/*/tests",
    "templates",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "workspaces": [
    "packages/opengantry-cage",
    "packages/opengantry-verify"
  ],
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "gen:catalog": "node scripts/gen-asset-catalog.mjs",
    "gen:dogfood": "node scripts/gen-dogfood.mjs",
    "build": "npm run gen:version && npm run gen:catalog && tsc -b && node scripts/prune-dist.mjs && npm run gen:schemas && npm run gen:dogfood && npm run build:cage && npm run build:verify",
    "build:cage": "npm run build -w @jeger-ai/opengantry-cage",
    "build:verify": "npm run build -w @jeger-ai/opengantry-verify",
    "lint": "eslint \"src/cli/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "lint:json": "eslint --format json \"src/cli/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "check:changed": "./scripts/check-changed-code.sh",
    "validate": "./scripts/dev-validate.sh",
    "prepublishOnly": "npm run build && npm test",
    "pack:check": "./scripts/npm-pack-check.sh",
    "test": "npm run build && node --import ./dist/cli/tests/test-tmpdir-setup.js --test \"dist/cli/tests/**/*.test.js\" && npm run test:packages && npm run test:cage && npm run test:verify",
    "test:cage": "node --test --test-concurrency=1 \"packages/opengantry-cage/tests/*.test.mjs\"",
    "test:verify": "node --test --test-concurrency=1 \"packages/opengantry-verify/tests/*.test.mjs\"",
    "test:conformance": "node --test \"test/conformance/run.test.mjs\"",
    "test:packages": "node --test \"dist/packages/*/tests/*.test.js\"",
    "examples:benchmark": "node examples/benchmark-agent/run-benchmark.mjs",
    "gantry": "node dist/cli/index.js",
    "gen:schemas": "node scripts/gen-schemas.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gxt",
    "gantry",
    "gantry-cli",
    "open-source-gantry",
    "git-hooks",
    "ai-agents",
    "governance",
    "devtools"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "sigstore": "^5.0.0",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeger-ai/opengantry.git"
  },
  "author": "Juergen Eger",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jeger-ai/opengantry/issues"
  },
  "homepage": "https://opengantry.ai"
}
