{
  "name": "@jeger-ai/opengantry",
  "version": "3.9.0",
  "description": "Open Source Gantry — vendor-neutral GXT substrate and Gantry CLI for local git-native agent governance",
  "type": "module",
  "bin": {
    "gantry": "dist/cli/index.js",
    "gapman": "dist/cli/index.js",
    "gantry-cage": "dist/cli/cage-bin.js",
    "opengantry-cage": "dist/cli/cage-bin.js"
  },
  "exports": {
    ".": "./dist/cli/index.js",
    "./kernel": "./dist/cli/kernel.js"
  },
  "files": [
    "dist",
    "!dist/cli/tests",
    "templates",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "gen:catalog": "node scripts/gen-asset-catalog.mjs",
    "gen:dogfood": "node scripts/gen-dogfood.mjs",
    "build": "npm run gen:version && npm run gen:catalog && npm run gen:dogfood && tsc && node scripts/prune-dist.mjs && npm run build:cage",
    "build:cage": "npm run build -w @jeger-ai/opengantry-cage",
    "gapman": "node dist/cli/index.js",
    "lint": "eslint src/cli/**/*.ts",
    "lint:json": "eslint --format json src/cli/**/*.ts",
    "check:changed": "./scripts/check-changed-code.sh",
    "validate": "./scripts/dev-validate.sh",
    "prepublishOnly": "npm run build && npm test",
    "pack:check": "./scripts/npm-pack-check.sh",
    "test": "npm run build && node --import ./dist/cli/tests/test-tmpdir-setup.js --test \"dist/cli/tests/**/*.test.js\" && npm run test:cage",
    "test:cage": "node --test --test-concurrency=1 \"packages/opengantry-cage/tests/*.test.mjs\"",
    "examples:benchmark": "node examples/benchmark-agent/run-benchmark.mjs",
    "gantry": "node dist/cli/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gxt",
    "gantry",
    "gantry-cli",
    "open-source-gantry",
    "git-hooks",
    "ai-agents",
    "governance",
    "devtools"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.6.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeger-ai/opengantry.git"
  },
  "author": "Juergen Eger",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jeger-ai/opengantry/issues"
  },
  "homepage": "https://opengantry.ai"
}
